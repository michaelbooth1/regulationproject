  },
  {
   "start": 6.52,
   "end": 6.76,
   "text": "Hello.",
   "speaker": "SPEAKER_02"
  },
  {
   "start": 7.04,
   "end": 8.3,
   "text": "Andrew, what's a f**kface?",
   "speaker": "SPEAKER_01"
  },
  {
   "start": 8.44,
   "end": 14.66,
   "text": "A f**kface is an event that happens that makes you look like an idiot, and the only way to deal with it is by laughing.",
   "speaker": "SPEAKER_01"
  },
  {
   "start": 14.78,
   "end": 15.84,
   "text": "And that's the podcast!",
   "speaker": "SPEAKER_01"
  },
  {
   "start": 17.94,
   "end": 19.24,
   "text": "Do you think you have anything in there?",
